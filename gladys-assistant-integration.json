{
  "manifest_version": 1,
  "type": "device",
  "name": "Irish Rail",
  "description": {
    "en": "Next Irish Rail and DART trains at your stations in Ireland, in real time, delays included.",
    "fr": "Prochains trains Irish Rail et DART de vos gares en Irlande, en temps réel, retards compris.",
    "de": "Nächste Irish-Rail- und DART-Züge deiner Bahnhöfe in Irland, in Echtzeit, mit Verspätungen.",
    "es": "Próximos trenes Irish Rail y DART de sus estaciones en Irlanda, en tiempo real, con retrasos."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-irish-rail:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-irish-rail/main/cover.png",
  "categories": ["services"],
  "countries": ["IE"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Comment ça marche",
        "de": "So funktioniert es",
        "es": "Cómo funciona"
      },
      "description": {
        "en": "Watch stations with the actions below, then create their devices in the Discover tab. Everything comes from the free Irish Rail realtime API: no account, no key.",
        "fr": "Suivez des gares avec les actions ci-dessous, puis créez leurs appareils dans l'onglet Découverte. Tout vient de l'API temps réel gratuite d'Irish Rail : ni compte, ni clé.",
        "de": "Verfolge Bahnhöfe mit den Aktionen unten und lege dann ihre Geräte im Tab „Entdecken“ an. Alles stammt aus der kostenlosen Echtzeit-API von Irish Rail: kein Konto, kein Schlüssel.",
        "es": "Siga estaciones con las acciones de abajo y luego cree sus dispositivos en la pestaña Descubrir. Todo procede de la API gratuita en tiempo real de Irish Rail: sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-irish-rail/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Language of the feature names and of the texts sent to your scenes. Feature names are set when a device is created.",
        "fr": "Langue des noms de fonctionnalités et des textes envoyés à vos scènes. Les noms sont fixés à la création d'un appareil.",
        "de": "Sprache der Funktionsnamen und der Texte für deine Szenen. Die Namen werden beim Anlegen eines Geräts festgelegt.",
        "es": "Idioma de los nombres de las funciones y de los textos enviados a sus escenas. Los nombres se fijan al crear un dispositivo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Irish Rail is read: one request per watched station.",
        "fr": "Fréquence de lecture d'Irish Rail : une requête par gare suivie.",
        "de": "Wie oft Irish Rail gelesen wird: eine Anfrage pro verfolgtem Bahnhof.",
        "es": "Frecuencia de lectura de Irish Rail: una petición por estación seguida."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search_stations",
      "label": {
        "en": "Find a station",
        "fr": "Chercher une gare",
        "de": "Bahnhof suchen",
        "es": "Buscar una estación"
      },
      "description": {
        "en": "Lists the stations matching a name, with their code.",
        "fr": "Liste les gares qui correspondent à un nom, avec leur code.",
        "de": "Listet die Bahnhöfe zu einem Namen mit ihrem Code auf.",
        "es": "Muestra las estaciones que coinciden con un nombre, con su código."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": true,
          "label": {
            "en": "Station name",
            "fr": "Nom de la gare",
            "de": "Name des Bahnhofs",
            "es": "Nombre de la estación"
          },
          "placeholder": {
            "en": "e.g. Pearse",
            "fr": "ex. Pearse",
            "de": "z. B. Pearse",
            "es": "p. ej. Pearse"
          }
        }
      ]
    },
    {
      "key": "add_station",
      "label": {
        "en": "Watch a station",
        "fr": "Suivre une gare",
        "de": "Bahnhof verfolgen",
        "es": "Seguir una estación"
      },
      "description": {
        "en": "Watches the departures of a station, with an optional type of train and direction.",
        "fr": "Suit les départs d'une gare, avec un type de train et une direction facultatifs.",
        "de": "Verfolgt die Abfahrten eines Bahnhofs, optional nach Zugtyp und Richtung.",
        "es": "Sigue las salidas de una estación, con un tipo de tren y una dirección opcionales."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "station",
          "type": "string",
          "required": true,
          "label": {
            "en": "Station name or code",
            "fr": "Nom ou code de la gare",
            "de": "Name oder Code des Bahnhofs",
            "es": "Nombre o código de la estación"
          },
          "placeholder": {
            "en": "e.g. Dublin Pearse or PERSE",
            "fr": "ex. Dublin Pearse ou PERSE",
            "de": "z. B. Dublin Pearse oder PERSE",
            "es": "p. ej. Dublin Pearse o PERSE"
          }
        },
        {
          "key": "train_type",
          "type": "select",
          "required": false,
          "label": {
            "en": "Type of train (empty: all)",
            "fr": "Type de train (vide : tous)",
            "de": "Zugtyp (leer: alle)",
            "es": "Tipo de tren (vacío: todos)"
          },
          "options": [
            {
              "value": "dart",
              "label": {
                "en": "DART only",
                "fr": "DART seulement",
                "de": "Nur DART",
                "es": "Solo DART"
              }
            },
            {
              "value": "train",
              "label": {
                "en": "Other trains only",
                "fr": "Autres trains seulement",
                "de": "Nur andere Züge",
                "es": "Solo otros trenes"
              }
            }
          ]
        },
        {
          "key": "direction",
          "type": "string",
          "required": false,
          "label": {
            "en": "Direction (empty: all)",
            "fr": "Direction (vide : toutes)",
            "de": "Richtung (leer: alle)",
            "es": "Dirección (vacío: todas)"
          },
          "description": {
            "en": "Part of the destination or of the direction: Northbound, Howth, Cork…",
            "fr": "Partie de la destination ou de la direction : Northbound, Howth, Cork…",
            "de": "Teil des Ziels oder der Richtung: Northbound, Howth, Cork…",
            "es": "Parte del destino o de la dirección: Northbound, Howth, Cork…"
          },
          "placeholder": {
            "en": "e.g. Northbound",
            "fr": "ex. Northbound",
            "de": "z. B. Northbound",
            "es": "p. ej. Northbound"
          }
        }
      ]
    },
    {
      "key": "remove_station",
      "label": {
        "en": "Stop watching a station",
        "fr": "Ne plus suivre une gare",
        "de": "Bahnhof nicht mehr verfolgen",
        "es": "Dejar de seguir una estación"
      },
      "description": {
        "en": "Removes a watched station. Its device stays in Gladys until you delete it.",
        "fr": "Retire une gare suivie. Son appareil reste dans Gladys jusqu'à ce que vous le supprimiez.",
        "de": "Entfernt einen verfolgten Bahnhof. Sein Gerät bleibt in Gladys, bis du es löschst.",
        "es": "Elimina una estación seguida. Su dispositivo permanece en Gladys hasta que lo elimine."
      },
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name shown in the status",
            "fr": "Nom affiché dans l'état",
            "de": "Name aus dem Status",
            "es": "Nombre mostrado en el estado"
          },
          "placeholder": {
            "en": "e.g. Dublin Pearse (DART)",
            "fr": "ex. Dublin Pearse (DART)",
            "de": "z. B. Dublin Pearse (DART)",
            "es": "p. ej. Dublin Pearse (DART)"
          }
        }
      ]
    },
    {
      "key": "status",
      "label": {
        "en": "Status",
        "fr": "État",
        "de": "Status",
        "es": "Estado"
      },
      "description": {
        "en": "Lists the watched stations and the last read of Irish Rail.",
        "fr": "Liste les gares suivies et la dernière lecture d'Irish Rail.",
        "de": "Listet die verfolgten Bahnhöfe und die letzte Abfrage von Irish Rail auf.",
        "es": "Muestra las estaciones seguidas y la última lectura de Irish Rail."
      }
    }
